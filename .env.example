# ==============================================================================
# subscription-gate | Plantilla de Variables de Entorno
# ==============================================================================
# Copia este archivo a los respectivos subproyectos (.env):
# - Para el panel web: admin-web/.env
# - Para el cliente de escritorio: variables del sistema o archivo de configuración
#
# Obtén estos valores en tu consola de Supabase:
# Settings (engranaje) -> API -> Project URL & Project API Keys
# ==============================================================================

# URL de tu proyecto de Supabase (ej. https://abcdefghijklm.supabase.co)
SUPABASE_URL=
VITE_SUPABASE_URL=

# Anon / Public Key (clave pública de Supabase segura para el cliente)
SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=

# Sal personalizada para el cálculo del hash de hardware de tu aplicación
HARDWARE_SALT=CAMBIA-ESTA-SAL
